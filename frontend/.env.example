# Set these in Vercel: Project > Settings > Environment Variables.
# For local testing, put them in .env.local (never commit that file).

# The password for /admin. Use a long, unique one.
ADMIN_PASSWORD=

# Fine-grained GitHub token with "Contents: Read and write" on this repository only.
# Leave empty locally: the admin then saves to files on this computer instead.
GITHUB_TOKEN=
